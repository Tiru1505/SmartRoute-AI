# ─── MongoDB ───────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=smartroute

# ─── CORS (comma-separated origins) ───────────────────────────
ALLOWED_ORIGINS=http://localhost:5173

# ─── Application ───────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# ─── Firebase Cloud Messaging (optional) ──────────────────────
FCM_SERVER_KEY=
